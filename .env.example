# Never paste real secrets into GitHub, chat, examples or browser configuration.
# Copy to .env.local for development; configure Vercel variables separately.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
# Optional PEM certificate trusted for the database connection.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_AUTH_KEY=
SUPABASE_ADMIN_KEY=
# Generate with: openssl rand -base64 32
APP_SESSION_ENCRYPTION_KEY=
SESSION_DAYS=7
# Leave false until S01–S04 pass in the selected production environment.
# This attestation does not replace the test evidence in docs/SECURITY.md.
RF007_VERIFIED=false
